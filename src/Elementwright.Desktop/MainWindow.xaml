<Window x:Class="Elementwright.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Elementwright Studio"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.RowSpan="2"
                Background="#141922"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="31" Height="31" CornerRadius="9"
                                Background="#2C5D9B" VerticalAlignment="Center">
                            <TextBlock Text="E" FontSize="19" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ELEMENTWRIGHT" FontSize="13"
                                       FontWeight="Bold" />
                            <TextBlock Text="AUTOMATION STUDIO" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="12,0">
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}"
                               FontSize="9" FontWeight="Bold" Margin="10,0,0,10" />
                    <Border Background="#24354C" CornerRadius="7" Padding="10,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}"
                                       FontSize="15" Width="25" />
                            <TextBlock Text="Inspector" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="ACTIVE" FontSize="8" Foreground="#8DBBFF"
                                       Margin="Auto" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◇" Foreground="{StaticResource MutedBrush}"
                                       FontSize="15" Width="25" />
                            <TextBlock Text="Workflow Designer" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▷" Foreground="{StaticResource MutedBrush}"
                                       FontSize="15" Width="25" />
                            <TextBlock Text="Runner" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DEVELOPMENT" Foreground="{StaticResource MutedBrush}"
                               FontSize="9" FontWeight="Bold" Margin="10,28,0,10" />
                    <Border Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘" Foreground="{StaticResource MutedBrush}"
                                       FontSize="15" Width="25" />
                            <TextBlock Text="Extensions" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Foreground="{StaticResource MutedBrush}"
                                       FontSize="15" Width="25" />
                            <TextBlock Text="Settings" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12" Padding="11"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="PROJECT STATUS" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Local environment" FontSize="10"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Elementwright · v0.1.0"
                                   FontSize="9" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Application Inspector" FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Discover, inspect and target Windows applications"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#1C2928" BorderBrush="#285448"
                                BorderThickness="1" CornerRadius="6"
                                Padding="9,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="ENGINE STANDBY" FontSize="9"
                                           Foreground="#8BD9BD" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="↻  Refresh applications"
                                Command="{Binding RefreshApplicationsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Target applications" FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DiscoveredCount, StringFormat={}{0} windows discovered}"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="245" Height="34"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by window title or process name" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <!-- Applications list -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="15,0">
                                <Grid>
                                    <TextBlock Text="RUNNING APPLICATIONS" FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="WINDOW TITLE  /  PROCESS"
                                               FontSize="9" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredApplications}"
                                      SelectedItem="{Binding SelectedApplication}"
                                      IsReadOnly="True"
                                      SelectionChanged="ApplicationsGrid_SelectionChanged"
                                      Margin="0,1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowTitle}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}"
                                                        Width="145" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}"
                                                        Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="14,0">
                                <Grid>
                                    <TextBlock Text="Select an application to inspect its details"
                                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Connect to target  →"
                                            Command="{Binding ConnectToApplicationCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedApplication}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Target details -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="17">
                        <StackPanel>
                            <TextBlock Text="TARGET DETAILS" FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,14,0,16" />
                            <Border Width="48" Height="48" CornerRadius="12"
                                    Background="#263B58" HorizontalAlignment="Left">
                                <TextBlock Text="▣" FontSize="23"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding SelectedApplication.WindowTitle, TargetNullValue=No application selected}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,14,0,4" />
                            <TextBlock Text="{Binding SelectedApplication.ProcessName, TargetNullValue=Choose a window from the list}"
                                       FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,17,0,14" />
                            <TextBlock Text="PROCESS ID" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedApplication.ProcessId, TargetNullValue=—}"
                                       FontSize="12" Margin="0,5,0,13" />
                            <TextBlock Text="EXECUTABLE PATH" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedApplication.ExecutablePath, TargetNullValue=—}"
                                       FontSize="10" TextWrapping="Wrap"
                                       Margin="0,5,0,13" />
                            <TextBlock Text="WINDOW HANDLE" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedApplication.MainWindowHandle, TargetNullValue=—}"
                                       FontSize="10" Margin="0,5,0,0" />
                            <Border Background="#1A2635" CornerRadius="7"
                                    Padding="10" Margin="0,22,0,0">
                                <TextBlock Text="UI Automation inspection will be available after connecting the target application."
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="#9CB5D5" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="#141922"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="15,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="9"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="WPF  ·  .NET 10  ·  Windows"
                           FontSize="9" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
